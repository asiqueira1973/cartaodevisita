{
  "name": "cartaodevisita",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emu": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_PROJECT_ID=cartao-de-visita-local vitest run --config vitest.emu.config.ts",
    "diagnostico": "node scripts/diagnostico.mjs",
    "deploy:rules": "npx --yes firebase-tools@14 deploy --only firestore:rules,storage",
    "emu": "npx --yes firebase-tools@14 emulators:start --only firestore,storage"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^11.1.0",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
