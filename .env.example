# Base das URLs absolutas (QR, vCard, Open Graph) — spec 18.6
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# Auth.js — spec 6.1
# Gere com: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase Admin SDK — spec 4.2. NUNCA versionar os valores reais.
FIREBASE_PROJECT_ID=cartao-de-visita-60325
# Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=cartao-de-visita-60325.firebasestorage.app

# Abertura a early adopters — spec 11.11.3. Lida SÓ na criação da conta.
EARLY_ADOPTER_ABERTO=true

# Visão de Produto — spec 21.3. Ausente = telemetria desligada, app funciona igual.
VISAO_API_KEY=
